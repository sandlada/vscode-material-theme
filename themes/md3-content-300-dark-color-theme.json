{
  "$schema": "vscode://schemas/color-theme",
  "name": "MD3:Content 300 Dark",
  "colors": {
    "focusBorder": "#d0bcff",
    "foreground": "#e7e0ed",
    "disabledForeground": "#958ea0",
    "descriptionForeground": "#cbc3d7",
    "errorForeground": "#ffb4ab",
    "icon.foreground": "#e7e0ed",
    "widget.border": "#4a4455",
    "widget.shadow": "#000000",
    "selection.background": "#37333d",
    "sash.hoverBorder": "#d0bcff",
    "button.background": "#d0bcff",
    "button.foreground": "#3c0091",
    "button.border": "#4a4455",
    "button.separator": "#4a4455",
    "button.hoverBackground": "#d0bcff",
    "button.secondaryBackground": "#37333d",
    "button.secondaryForeground": "#e7e0ed",
    "button.secondaryHoverBackground": "#37333d",
    "checkbox.background": "#37333d",
    "checkbox.border": "#958ea0",
    "dropdown.background": "#37333d",
    "dropdown.border": "#4a4455",
    "dropdown.foreground": "#e7e0ed",
    "dropdown.listBackground": "#2c2832",
    "input.background": "#37333d",
    "input.border": "#4a4455",
    "input.foreground": "#e7e0ed",
    "input.placeholderForeground": "#cbc3d7",
    "scrollbarSlider.background": "#37333d",
    "scrollbarSlider.hoverBackground": "#4a4455",
    "scrollbarSlider.activeBackground": "#958ea0",
    "badge.background": "#d0bcff",
    "badge.foreground": "#3c0091",
    "progressBar.background": "#d0bcff",
    "list.activeSelectionBackground": "#37333d",
    "list.activeSelectionForeground": "#e7e0ed",
    "list.inactiveSelectionBackground": "#2c2832",
    "list.inactiveSelectionForeground": "#e7e0ed",
    "list.hoverBackground": "#2c2832",
    "list.hoverForeground": "#e7e0ed",
    "list.focusOutline": "#d0bcff",
    "list.highlightForeground": "#d0bcff",
    "list.errorForeground": "#ffb4ab",
    "list.warningForeground": "#ffdad6",
    "activityBar.background": "#211e28",
    "activityBar.foreground": "#e7e0ed",
    "activityBar.inactiveForeground": "#cbc3d7",
    "activityBar.border": "#4a4455",
    "activityBar.activeBorder": "#d0bcff",
    "activityBarBadge.background": "#d0bcff",
    "activityBarBadge.foreground": "#3c0091",
    "sideBar.background": "#211e28",
    "sideBar.foreground": "#e7e0ed",
    "sideBar.border": "#4a4455",
    "sideBarTitle.foreground": "#e7e0ed",
    "sideBarSectionHeader.background": "#211e28",
    "sideBarSectionHeader.foreground": "#cbc3d7",
    "sideBarSectionHeader.border": "#4a4455",
    "editorGroup.border": "#4a4455",
    "editorGroup.dropBackground": "#d0bcff66",
    "editorGroupHeader.tabsBackground": "#211e28",
    "editorGroupHeader.tabsBorder": "#4a4455",
    "tab.activeBackground": "#15121b",
    "tab.activeForeground": "#e7e0ed",
    "tab.activeBorderTop": "#d0bcff",
    "tab.inactiveBackground": "#2c2832",
    "tab.inactiveForeground": "#cbc3d7",
    "tab.hoverBackground": "#37333d",
    "tab.border": "#4a4455",
    "tab.unfocusedActiveBackground": "#211e28",
    "editor.background": "#15121b",
    "editor.foreground": "#e7e0ed",
    "editorLineNumber.foreground": "#958ea0",
    "editorLineNumber.activeForeground": "#e7e0ed",
    "editorCursor.foreground": "#d0bcff",
    "editor.selectionBackground": "#37333d",
    "editor.inactiveSelectionBackground": "#2c2832",
    "editor.lineHighlightBackground": "#211e28",
    "editorWhitespace.foreground": "#4a4455",
    "editorIndentGuide.background": "#4a4455",
    "editorIndentGuide.activeBackground": "#958ea0",
    "editorBracketMatch.background": "#513c8366",
    "editorBracketMatch.border": "#958ea0",
    "editor.findMatchBackground": "#d0bcff66",
    "editor.findMatchHighlightBackground": "#513c8366",
    "editor.hoverHighlightBackground": "#513c8366",
    "editor.rangeHighlightBackground": "#513c8366",
    "editorError.foreground": "#ffb4ab",
    "editorWarning.foreground": "#ffdad6",
    "editorInfo.foreground": "#d0bcff",
    "editorGutter.addedBackground": "#ffade2",
    "editorGutter.modifiedBackground": "#d0bcff",
    "editorGutter.deletedBackground": "#ffb4ab",
    "diffEditor.insertedTextBackground": "#37333d66",
    "diffEditor.removedTextBackground": "#37333d66",
    "diffEditor.insertedLineBackground": "#37333d66",
    "diffEditor.removedLineBackground": "#37333d66",
    "gitDecoration.addedResourceForeground": "#ffade2",
    "gitDecoration.modifiedResourceForeground": "#d0bcff",
    "gitDecoration.deletedResourceForeground": "#ffb4ab",
    "gitDecoration.untrackedResourceForeground": "#ffade2",
    "terminal.background": "#211e28",
    "terminal.foreground": "#e7e0ed",
    "terminalCursor.foreground": "#d0bcff",
    "terminal.selectionBackground": "#37333d",
    "statusBar.background": "#211e28",
    "statusBar.foreground": "#e7e0ed",
    "statusBar.border": "#4a4455",
    "statusBarItem.hoverBackground": "#2c2832",
    "statusBar.debuggingBackground": "#ffb4ab",
    "statusBar.debuggingForeground": "#690005",
    "statusBar.noFolderBackground": "#211e28",
    "titleBar.activeBackground": "#211e28",
    "titleBar.activeForeground": "#e7e0ed",
    "titleBar.inactiveBackground": "#1d1a24",
    "titleBar.inactiveForeground": "#cbc3d7",
    "titleBar.border": "#4a4455",
    "panel.background": "#211e28",
    "panel.border": "#4a4455",
    "panelTitle.activeBorder": "#d0bcff",
    "panelTitle.activeForeground": "#e7e0ed",
    "panelTitle.inactiveForeground": "#cbc3d7",
    "quickInput.background": "#2c2832",
    "quickInput.foreground": "#e7e0ed",
    "notifications.background": "#2c2832",
    "notifications.border": "#4a4455",
    "notifications.foreground": "#e7e0ed",
    "textLink.foreground": "#d0bcff",
    "textLink.activeForeground": "#d0bcff",
    "textBlockQuote.background": "#2c2832",
    "textBlockQuote.border": "#4a4455",
    "textCodeBlock.background": "#0f0d16",
    "menu.background": "#15121b",
    "menu.foreground": "#e7e0ed",
    "menu.selectionBackground": "#37333d",
    "menu.selectionForeground": "#e7e0ed",
    "menu.separatorBackground": "#4a4455",
    "menu.border": "#4a4455"
  },
  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#ababab"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "string.tag",
        "string.value",
        "meta.embedded.assembly",
        "meta.preprocessor.string"
      ],
      "settings": {
        "foreground": "#40e26e"
      }
    },
    {
      "name": "value",
      "scope": [
        "support.constant.property-value",
        "support.constant.font-name",
        "support.constant.media-type",
        "support.constant.media",
        "constant.other.color.rgb-value",
        "constant.other.rgb-value",
        "support.constant.color",
        "punctuation.definition.group.regexp",
        "punctuation.definition.group.assertion.regexp",
        "punctuation.definition.character-class.regexp",
        "punctuation.character.set.begin.regexp",
        "punctuation.character.set.end.regexp",
        "keyword.operator.negation.regexp",
        "support.other.parenthesis.regexp"
      ],
      "settings": {
        "foreground": "#40e26e"
      }
    },
    {
      "name": "stringRegexp",
      "scope": [
        "string.regexp",
        "constant.regexp",
        "constant.character.character-class.regexp",
        "constant.other.character-class.set.regexp",
        "constant.other.character-class.regexp",
        "constant.character.set.regexp"
      ],
      "settings": {
        "foreground": "#ffa9ff"
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric",
        "keyword.operator.plus.exponent",
        "keyword.operator.minus.exponent",
        "meta.preprocessor.numeric"
      ],
      "settings": {
        "foreground": "#ffb4a5"
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant.language",
        "variable.other.constant",
        "variable.other.enummember",
        "constant.character",
        "constant.other.option"
      ],
      "settings": {
        "foreground": "#ffb779"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "keyword.operator.wordlike",
        "keyword.other.unit",
        "storage",
        "storage.modifier",
        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#b1c5ff"
      }
    },
    {
      "name": "keywordControl",
      "scope": [
        "keyword.control",
        "source.cpp keyword.operator.new",
        "keyword.operator.delete",
        "keyword.other.using",
        "keyword.other.directive.using",
        "keyword.other.operator",
        "entity.name.operator"
      ],
      "settings": {
        "foreground": "#88ceff"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#c6c6c6"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "support.constant.handlebars",
        "source.powershell variable.other.member",
        "entity.name.operator.custom-literal",
        "keyword.operator.or.regexp",
        "keyword.control.anchor.regexp"
      ],
      "settings": {
        "foreground": "#b7d300"
      }
    },
    {
      "name": "type",
      "scope": [
        "support.class",
        "support.type",
        "entity.name.type",
        "entity.name.namespace",
        "entity.other.attribute",
        "entity.name.scope-resolution",
        "entity.name.class",
        "storage.type",
        "meta.type.cast.expr",
        "meta.type.new.expr",
        "support.constant.math",
        "support.constant.dom",
        "support.constant.json",
        "entity.other.inherited-class",
        "punctuation.separator.namespace.ruby",
        "storage.type.numeric.go",
        "storage.type.byte.go",
        "storage.type.boolean.go",
        "storage.type.string.go",
        "storage.type.uintptr.go",
        "storage.type.error.go",
        "storage.type.rune.go",
        "storage.type.cs",
        "storage.type.generic.cs",
        "storage.type.modifier.cs",
        "storage.type.variable.cs",
        "storage.type.annotation.java",
        "storage.type.generic.java",
        "storage.type.java",
        "storage.type.object.array.java",
        "storage.type.primitive.array.java",
        "storage.type.primitive.java",
        "storage.type.token.java",
        "storage.type.groovy",
        "storage.type.annotation.groovy",
        "storage.type.parameters.groovy",
        "storage.type.generic.groovy",
        "storage.type.object.array.groovy",
        "storage.type.primitive.array.groovy",
        "storage.type.primitive.groovy"
      ],
      "settings": {
        "foreground": "#00dfc0"
      }
    },
    {
      "name": "variable",
      "scope": [
        "variable",
        "meta.definition.variable.name",
        "support.variable",
        "entity.name.variable",
        "constant.other.placeholder",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#00daf2"
      }
    },
    {
      "name": "property",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "support.type.vendored.property-name",
        "variable.other.property",
        "meta.structure.dictionary.key.python"
      ],
      "settings": {
        "foreground": "#f4c000"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.css",
        "entity.name.tag.less",
        "punctuation.definition.tag",
        "keyword.operator.quantifier.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#d0bcff"
      }
    },
    {
      "name": "interpolation",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#d0bcff"
      }
    },
    {
      "name": "markupHeading",
      "scope": [
        "markup.heading",
        "header"
      ],
      "settings": {
        "foreground": "#b1c5ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markupBold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#b1c5ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markupItalic",
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "foreground": "#b1c5ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "markupInserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#40e26e"
      }
    },
    {
      "name": "markupDeleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ffb1c8"
      }
    },
    {
      "name": "markupChanged",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#00daf2"
      }
    },
    {
      "name": "markdownRaw",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#40e26e"
      }
    },
    {
      "name": "markdownQuote",
      "scope": [
        "punctuation.definition.quote.begin.markdown"
      ],
      "settings": {
        "foreground": "#ababab"
      }
    },
    {
      "name": "link",
      "scope": [
        "markup.underline.link.markdown"
      ],
      "settings": {
        "foreground": "#88ceff",
        "fontStyle": "underline"
      }
    },
    {
      "name": "diffHeader",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#00daf2"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ffb1c8"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "newOperator": "#88ceff",
    "stringLiteral": "#40e26e",
    "customLiteral": "#b7d300",
    "numberLiteral": "#ffb4a5"
  }
}

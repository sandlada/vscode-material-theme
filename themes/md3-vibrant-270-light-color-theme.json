{
  "$schema": "vscode://schemas/color-theme",
  "name": "MD3:Vibrant 270 Light",
  "colors": {
    "focusBorder": "#0054ca",
    "foreground": "#262c51",
    "disabledForeground": "#6f749e",
    "descriptionForeground": "#545981",
    "errorForeground": "#8e1400",
    "icon.foreground": "#262c51",
    "widget.border": "#a5aad7",
    "widget.shadow": "#000000",
    "selection.background": "#d8daff",
    "sash.hoverBorder": "#0054ca",
    "button.background": "#0054ca",
    "button.foreground": "#f1f2ff",
    "button.border": "#a5aad7",
    "button.separator": "#a5aad7",
    "button.hoverBackground": "#0054ca",
    "button.secondaryBackground": "#d8daff",
    "button.secondaryForeground": "#262c51",
    "button.secondaryHoverBackground": "#d8daff",
    "checkbox.background": "#d8daff",
    "checkbox.border": "#6f749e",
    "dropdown.background": "#d8daff",
    "dropdown.border": "#a5aad7",
    "dropdown.foreground": "#262c51",
    "dropdown.listBackground": "#dfe0ff",
    "input.background": "#d8daff",
    "input.border": "#a5aad7",
    "input.foreground": "#262c51",
    "input.placeholderForeground": "#545981",
    "scrollbarSlider.background": "#54598166",
    "scrollbarSlider.hoverBackground": "#54598199",
    "scrollbarSlider.activeBackground": "#545981b3",
    "badge.background": "#0054ca",
    "badge.foreground": "#f1f2ff",
    "progressBar.background": "#0054ca",
    "list.activeSelectionBackground": "#d8daff",
    "list.activeSelectionForeground": "#262c51",
    "list.inactiveSelectionBackground": "#dfe0ff",
    "list.inactiveSelectionForeground": "#262c51",
    "list.hoverBackground": "#dfe0ff",
    "list.hoverForeground": "#262c51",
    "list.focusOutline": "#0054ca",
    "list.highlightForeground": "#0054ca",
    "list.errorForeground": "#8e1400",
    "list.warningForeground": "#6c3a00",
    "activityBar.background": "#e6e6ff",
    "activityBar.foreground": "#262c51",
    "activityBar.inactiveForeground": "#545981",
    "activityBar.border": "#a5aad7",
    "activityBar.activeBorder": "#0054ca",
    "activityBarBadge.background": "#0054ca",
    "activityBarBadge.foreground": "#f1f2ff",
    "sideBar.background": "#e6e6ff",
    "sideBar.foreground": "#262c51",
    "sideBar.border": "#a5aad7",
    "sideBarTitle.foreground": "#262c51",
    "sideBarSectionHeader.background": "#e6e6ff",
    "sideBarSectionHeader.foreground": "#545981",
    "sideBarSectionHeader.border": "#a5aad7",
    "editorGroup.border": "#a5aad7",
    "editorGroup.dropBackground": "#0054ca66",
    "editorGroupHeader.tabsBackground": "#e6e6ff",
    "editorGroupHeader.tabsBorder": "#a5aad7",
    "tab.activeBackground": "#f7f5ff",
    "tab.activeForeground": "#262c51",
    "tab.activeBorderTop": "#0054ca",
    "tab.inactiveBackground": "#dfe0ff",
    "tab.inactiveForeground": "#545981",
    "tab.hoverBackground": "#d8daff",
    "tab.border": "#a5aad7",
    "tab.unfocusedActiveBackground": "#e6e6ff",
    "editor.background": "#f7f5ff",
    "editor.foreground": "#262c51",
    "editorLineNumber.foreground": "#6f749e",
    "editorLineNumber.activeForeground": "#262c51",
    "editorCursor.foreground": "#0054ca",
    "editor.selectionBackground": "#d8daff",
    "editor.inactiveSelectionBackground": "#dfe0ff",
    "editor.lineHighlightBackground": "#e6e6ff",
    "editorWhitespace.foreground": "#a5aad7",
    "editorIndentGuide.background": "#a5aad7",
    "editorIndentGuide.activeBackground": "#6f749e",
    "editorBracketMatch.background": "#caceff66",
    "editorBracketMatch.border": "#6f749e",
    "editor.findMatchBackground": "#0054ca66",
    "editor.findMatchHighlightBackground": "#caceff66",
    "editor.hoverHighlightBackground": "#caceff66",
    "editor.rangeHighlightBackground": "#caceff66",
    "editorError.foreground": "#8e1400",
    "editorWarning.foreground": "#6c3a00",
    "editorInfo.foreground": "#004c6d",
    "editorGutter.addedBackground": "#00531f",
    "editorGutter.modifiedBackground": "#004c6d",
    "editorGutter.deletedBackground": "#8e1400",
    "editorGutter.addedSecondaryBackground": "#00531f99",
    "editorGutter.modifiedSecondaryBackground": "#004c6d99",
    "editorGutter.deletedSecondaryBackground": "#8e140099",
    "editorOverviewRuler.addedForeground": "#00531f99",
    "editorOverviewRuler.modifiedForeground": "#004c6d99",
    "editorOverviewRuler.deletedForeground": "#8e140099",
    "editorOverviewRuler.errorForeground": "#8e140099",
    "editorOverviewRuler.warningForeground": "#6c3a0099",
    "editorOverviewRuler.infoForeground": "#004c6d99",
    "diffEditor.insertedTextBackground": "#dfe0ff66",
    "diffEditor.removedTextBackground": "#dfe0ff66",
    "diffEditor.insertedLineBackground": "#dfe0ff66",
    "diffEditor.removedLineBackground": "#dfe0ff66",
    "gitDecoration.addedResourceForeground": "#00531f",
    "gitDecoration.modifiedResourceForeground": "#004c6d",
    "gitDecoration.deletedResourceForeground": "#8e1400",
    "gitDecoration.renamedResourceForeground": "#560bc5",
    "gitDecoration.untrackedResourceForeground": "#00531f",
    "gitDecoration.ignoredResourceForeground": "#777777",
    "gitDecoration.conflictingResourceForeground": "#8e1400",
    "gitDecoration.stageModifiedResourceForeground": "#6c3a00",
    "gitDecoration.stageDeletedResourceForeground": "#8e1400",
    "gitDecoration.submoduleResourceForeground": "#004c6d",
    "terminal.background": "#e6e6ff",
    "terminal.foreground": "#262c51",
    "terminalCursor.foreground": "#0054ca",
    "terminal.selectionBackground": "#d8daff",
    "statusBar.background": "#e6e6ff",
    "statusBar.foreground": "#262c51",
    "statusBar.border": "#a5aad7",
    "statusBarItem.hoverBackground": "#dfe0ff",
    "statusBar.debuggingBackground": "#b31b25",
    "statusBar.debuggingForeground": "#ffefee",
    "statusBar.noFolderBackground": "#e6e6ff",
    "titleBar.activeBackground": "#e6e6ff",
    "titleBar.activeForeground": "#262c51",
    "titleBar.inactiveBackground": "#f0efff",
    "titleBar.inactiveForeground": "#545981",
    "titleBar.border": "#a5aad7",
    "panel.background": "#e6e6ff",
    "panel.border": "#a5aad7",
    "panelTitle.activeBorder": "#0054ca",
    "panelTitle.activeForeground": "#262c51",
    "panelTitle.inactiveForeground": "#545981",
    "quickInput.background": "#dfe0ff",
    "quickInput.foreground": "#262c51",
    "notifications.background": "#dfe0ff",
    "notifications.border": "#a5aad7",
    "notifications.foreground": "#262c51",
    "textLink.foreground": "#0054ca",
    "textLink.activeForeground": "#0054ca",
    "textBlockQuote.background": "#dfe0ff",
    "textBlockQuote.border": "#a5aad7",
    "textCodeBlock.background": "#ffffff",
    "menu.background": "#f7f5ff",
    "menu.foreground": "#262c51",
    "menu.selectionBackground": "#d8daff",
    "menu.selectionForeground": "#262c51",
    "menu.separatorBackground": "#a5aad7",
    "menu.border": "#a5aad7"
  },
  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#777777"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "string.tag",
        "string.value",
        "meta.embedded.assembly",
        "meta.preprocessor.string"
      ],
      "settings": {
        "foreground": "#006e2c"
      }
    },
    {
      "name": "value",
      "scope": [
        "support.constant.property-value",
        "support.constant.font-name",
        "support.constant.media-type",
        "support.constant.media",
        "constant.other.color.rgb-value",
        "constant.other.rgb-value",
        "support.constant.color",
        "punctuation.definition.group.regexp",
        "punctuation.definition.group.assertion.regexp",
        "punctuation.definition.character-class.regexp",
        "punctuation.character.set.begin.regexp",
        "punctuation.character.set.end.regexp",
        "keyword.operator.negation.regexp",
        "support.other.parenthesis.regexp"
      ],
      "settings": {
        "foreground": "#006e2c"
      }
    },
    {
      "name": "stringRegexp",
      "scope": [
        "string.regexp",
        "constant.regexp",
        "constant.character.character-class.regexp",
        "constant.other.character-class.set.regexp",
        "constant.other.character-class.regexp",
        "constant.character.set.regexp"
      ],
      "settings": {
        "foreground": "#9d23aa"
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric",
        "keyword.operator.plus.exponent",
        "keyword.operator.minus.exponent",
        "meta.preprocessor.numeric"
      ],
      "settings": {
        "foreground": "#b22b13"
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant.language",
        "variable.other.constant",
        "variable.other.enummember",
        "constant.character",
        "constant.other.option"
      ],
      "settings": {
        "foreground": "#8f4e00"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "keyword.operator.wordlike",
        "keyword.other.unit",
        "storage",
        "storage.modifier",
        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#0056d0"
      }
    },
    {
      "name": "keywordControl",
      "scope": [
        "keyword.control",
        "source.cpp keyword.operator.new",
        "keyword.operator.delete",
        "keyword.other.using",
        "keyword.other.directive.using",
        "keyword.other.operator",
        "entity.name.operator"
      ],
      "settings": {
        "foreground": "#006590"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#5e5e5e"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "support.constant.handlebars",
        "source.powershell variable.other.member",
        "entity.name.operator.custom-literal",
        "keyword.operator.or.regexp",
        "keyword.control.anchor.regexp"
      ],
      "settings": {
        "foreground": "#566500"
      }
    },
    {
      "name": "type",
      "scope": [
        "support.class",
        "support.type",
        "entity.name.type",
        "entity.name.namespace",
        "entity.other.attribute",
        "entity.name.scope-resolution",
        "entity.name.class",
        "storage.type",
        "meta.type.cast.expr",
        "meta.type.new.expr",
        "support.constant.math",
        "support.constant.dom",
        "support.constant.json",
        "entity.other.inherited-class",
        "punctuation.separator.namespace.ruby",
        "storage.type.numeric.go",
        "storage.type.byte.go",
        "storage.type.boolean.go",
        "storage.type.string.go",
        "storage.type.uintptr.go",
        "storage.type.error.go",
        "storage.type.rune.go",
        "storage.type.cs",
        "storage.type.generic.cs",
        "storage.type.modifier.cs",
        "storage.type.variable.cs",
        "storage.type.annotation.java",
        "storage.type.generic.java",
        "storage.type.java",
        "storage.type.object.array.java",
        "storage.type.primitive.array.java",
        "storage.type.primitive.java",
        "storage.type.token.java",
        "storage.type.groovy",
        "storage.type.annotation.groovy",
        "storage.type.parameters.groovy",
        "storage.type.generic.groovy",
        "storage.type.object.array.groovy",
        "storage.type.primitive.array.groovy",
        "storage.type.primitive.groovy"
      ],
      "settings": {
        "foreground": "#006b5b"
      }
    },
    {
      "name": "variable",
      "scope": [
        "variable",
        "meta.definition.variable.name",
        "support.variable",
        "entity.name.variable",
        "constant.other.placeholder",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#006874"
      }
    },
    {
      "name": "property",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "support.type.vendored.property-name",
        "variable.other.property",
        "meta.structure.dictionary.key.python"
      ],
      "settings": {
        "foreground": "#755b00"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.css",
        "entity.name.tag.less",
        "punctuation.definition.tag",
        "keyword.operator.quantifier.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#6e37dd"
      }
    },
    {
      "name": "interpolation",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#6e37dd"
      }
    },
    {
      "name": "markupHeading",
      "scope": [
        "markup.heading",
        "header"
      ],
      "settings": {
        "foreground": "#0056d0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markupBold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#0056d0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markupItalic",
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "foreground": "#0056d0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "markupInserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#006e2c"
      }
    },
    {
      "name": "markupDeleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#b22b13"
      }
    },
    {
      "name": "markupChanged",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#006874"
      }
    },
    {
      "name": "markdownRaw",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#006e2c"
      }
    },
    {
      "name": "markdownQuote",
      "scope": [
        "punctuation.definition.quote.begin.markdown"
      ],
      "settings": {
        "foreground": "#777777"
      }
    },
    {
      "name": "link",
      "scope": [
        "markup.underline.link.markdown"
      ],
      "settings": {
        "foreground": "#006590",
        "fontStyle": "underline"
      }
    },
    {
      "name": "diffHeader",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#006874"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#b22b13"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "newOperator": "#006590",
    "stringLiteral": "#006e2c",
    "customLiteral": "#566500",
    "numberLiteral": "#b22b13"
  }
}

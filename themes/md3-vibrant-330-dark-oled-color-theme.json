{
  "$schema": "vscode://schemas/color-theme",
  "name": "MD3:Vibrant 330 Dark OLED",
  "colors": {
    "focusBorder": "#f87eff",
    "foreground": "#ffdcf1",
    "disabledForeground": "#946887",
    "descriptionForeground": "#ce9cbe",
    "errorForeground": "#ff6e84",
    "icon.foreground": "#ffdcf1",
    "widget.border": "#623b58",
    "widget.shadow": "#000000",
    "selection.background": "#421339",
    "sash.hoverBorder": "#f87eff",
    "button.background": "#f87eff",
    "button.foreground": "#55005f",
    "button.border": "#623b58",
    "button.separator": "#623b58",
    "button.hoverBackground": "#f87eff",
    "button.secondaryBackground": "#421339",
    "button.secondaryForeground": "#ffdcf1",
    "button.secondaryHoverBackground": "#421339",
    "checkbox.background": "#421339",
    "checkbox.border": "#946887",
    "dropdown.background": "#421339",
    "dropdown.border": "#623b58",
    "dropdown.foreground": "#ffdcf1",
    "dropdown.listBackground": "#390e31",
    "input.background": "#421339",
    "input.border": "#623b58",
    "input.foreground": "#ffdcf1",
    "input.placeholderForeground": "#ce9cbe",
    "scrollbarSlider.background": "#421339",
    "scrollbarSlider.hoverBackground": "#623b58",
    "scrollbarSlider.activeBackground": "#946887",
    "badge.background": "#f87eff",
    "badge.foreground": "#55005f",
    "progressBar.background": "#f87eff",
    "list.activeSelectionBackground": "#421339",
    "list.activeSelectionForeground": "#ffdcf1",
    "list.inactiveSelectionBackground": "#390e31",
    "list.inactiveSelectionForeground": "#ffdcf1",
    "list.hoverBackground": "#390e31",
    "list.hoverForeground": "#ffdcf1",
    "list.focusOutline": "#f87eff",
    "list.highlightForeground": "#f87eff",
    "list.errorForeground": "#ff6e84",
    "list.warningForeground": "#ffb2b9",
    "activityBar.background": "#30092a",
    "activityBar.foreground": "#ffdcf1",
    "activityBar.inactiveForeground": "#ce9cbe",
    "activityBar.border": "#623b58",
    "activityBar.activeBorder": "#f87eff",
    "activityBarBadge.background": "#f87eff",
    "activityBarBadge.foreground": "#55005f",
    "sideBar.background": "#30092a",
    "sideBar.foreground": "#ffdcf1",
    "sideBar.border": "#623b58",
    "sideBarTitle.foreground": "#ffdcf1",
    "sideBarSectionHeader.background": "#30092a",
    "sideBarSectionHeader.foreground": "#ce9cbe",
    "sideBarSectionHeader.border": "#623b58",
    "editorGroup.border": "#623b58",
    "editorGroup.dropBackground": "#f87eff66",
    "editorGroupHeader.tabsBackground": "#30092a",
    "editorGroupHeader.tabsBorder": "#623b58",
    "tab.activeBackground": "#000000",
    "tab.activeForeground": "#ffdcf1",
    "tab.activeBorderTop": "#f87eff",
    "tab.inactiveBackground": "#390e31",
    "tab.inactiveForeground": "#ce9cbe",
    "tab.hoverBackground": "#421339",
    "tab.border": "#623b58",
    "tab.unfocusedActiveBackground": "#30092a",
    "editor.background": "#000000",
    "editor.foreground": "#ffdcf1",
    "editorLineNumber.foreground": "#946887",
    "editorLineNumber.activeForeground": "#ffdcf1",
    "editorCursor.foreground": "#f87eff",
    "editor.selectionBackground": "#421339",
    "editor.inactiveSelectionBackground": "#390e31",
    "editor.lineHighlightBackground": "#30092a",
    "editorWhitespace.foreground": "#623b58",
    "editorIndentGuide.background": "#623b58",
    "editorIndentGuide.activeBackground": "#946887",
    "editorBracketMatch.background": "#79226a66",
    "editorBracketMatch.border": "#946887",
    "editor.findMatchBackground": "#f87eff66",
    "editor.findMatchHighlightBackground": "#79226a66",
    "editor.hoverHighlightBackground": "#79226a66",
    "editor.rangeHighlightBackground": "#79226a66",
    "editorError.foreground": "#ff6e84",
    "editorWarning.foreground": "#ffb2b9",
    "editorInfo.foreground": "#fb92e1",
    "editorGutter.addedBackground": "#ff987f",
    "editorGutter.modifiedBackground": "#fb92e1",
    "editorGutter.deletedBackground": "#ff6e84",
    "diffEditor.insertedTextBackground": "#42133966",
    "diffEditor.removedTextBackground": "#42133966",
    "diffEditor.insertedLineBackground": "#42133966",
    "diffEditor.removedLineBackground": "#42133966",
    "gitDecoration.addedResourceForeground": "#ff987f",
    "gitDecoration.modifiedResourceForeground": "#fb92e1",
    "gitDecoration.deletedResourceForeground": "#ff6e84",
    "gitDecoration.untrackedResourceForeground": "#ff987f",
    "terminal.background": "#30092a",
    "terminal.foreground": "#ffdcf1",
    "terminalCursor.foreground": "#f87eff",
    "terminal.selectionBackground": "#421339",
    "statusBar.background": "#30092a",
    "statusBar.foreground": "#ffdcf1",
    "statusBar.border": "#623b58",
    "statusBarItem.hoverBackground": "#390e31",
    "statusBar.debuggingBackground": "#ff6e84",
    "statusBar.debuggingForeground": "#490013",
    "statusBar.noFolderBackground": "#30092a",
    "titleBar.activeBackground": "#30092a",
    "titleBar.activeForeground": "#ffdcf1",
    "titleBar.inactiveBackground": "#280522",
    "titleBar.inactiveForeground": "#ce9cbe",
    "titleBar.border": "#623b58",
    "panel.background": "#30092a",
    "panel.border": "#623b58",
    "panelTitle.activeBorder": "#f87eff",
    "panelTitle.activeForeground": "#ffdcf1",
    "panelTitle.inactiveForeground": "#ce9cbe",
    "quickInput.background": "#390e31",
    "quickInput.foreground": "#ffdcf1",
    "notifications.background": "#390e31",
    "notifications.border": "#623b58",
    "notifications.foreground": "#ffdcf1",
    "textLink.foreground": "#f87eff",
    "textLink.activeForeground": "#f87eff",
    "textBlockQuote.background": "#390e31",
    "textBlockQuote.border": "#623b58",
    "textCodeBlock.background": "#000000",
    "menu.background": "#000000",
    "menu.foreground": "#ffdcf1",
    "menu.selectionBackground": "#421339",
    "menu.selectionForeground": "#ffdcf1",
    "menu.separatorBackground": "#623b58",
    "menu.border": "#623b58"
  },
  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#ababab"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "string.tag",
        "string.value",
        "meta.embedded.assembly",
        "meta.preprocessor.string"
      ],
      "settings": {
        "foreground": "#40e26e"
      }
    },
    {
      "name": "value",
      "scope": [
        "support.constant.property-value",
        "support.constant.font-name",
        "support.constant.media-type",
        "support.constant.media",
        "constant.other.color.rgb-value",
        "constant.other.rgb-value",
        "support.constant.color",
        "punctuation.definition.group.regexp",
        "punctuation.definition.group.assertion.regexp",
        "punctuation.definition.character-class.regexp",
        "punctuation.character.set.begin.regexp",
        "punctuation.character.set.end.regexp",
        "keyword.operator.negation.regexp",
        "support.other.parenthesis.regexp"
      ],
      "settings": {
        "foreground": "#40e26e"
      }
    },
    {
      "name": "stringRegexp",
      "scope": [
        "string.regexp",
        "constant.regexp",
        "constant.character.character-class.regexp",
        "constant.other.character-class.set.regexp",
        "constant.other.character-class.regexp",
        "constant.character.set.regexp"
      ],
      "settings": {
        "foreground": "#ffa9ff"
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric",
        "keyword.operator.plus.exponent",
        "keyword.operator.minus.exponent",
        "meta.preprocessor.numeric"
      ],
      "settings": {
        "foreground": "#ffb4a5"
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant.language",
        "variable.other.constant",
        "variable.other.enummember",
        "constant.character",
        "constant.other.option"
      ],
      "settings": {
        "foreground": "#ffb779"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "keyword.operator.wordlike",
        "keyword.other.unit",
        "storage",
        "storage.modifier",
        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#b1c5ff"
      }
    },
    {
      "name": "keywordControl",
      "scope": [
        "keyword.control",
        "source.cpp keyword.operator.new",
        "keyword.operator.delete",
        "keyword.other.using",
        "keyword.other.directive.using",
        "keyword.other.operator",
        "entity.name.operator"
      ],
      "settings": {
        "foreground": "#88ceff"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#c6c6c6"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "support.constant.handlebars",
        "source.powershell variable.other.member",
        "entity.name.operator.custom-literal",
        "keyword.operator.or.regexp",
        "keyword.control.anchor.regexp"
      ],
      "settings": {
        "foreground": "#b7d300"
      }
    },
    {
      "name": "type",
      "scope": [
        "support.class",
        "support.type",
        "entity.name.type",
        "entity.name.namespace",
        "entity.other.attribute",
        "entity.name.scope-resolution",
        "entity.name.class",
        "storage.type",
        "meta.type.cast.expr",
        "meta.type.new.expr",
        "support.constant.math",
        "support.constant.dom",
        "support.constant.json",
        "entity.other.inherited-class",
        "punctuation.separator.namespace.ruby",
        "storage.type.numeric.go",
        "storage.type.byte.go",
        "storage.type.boolean.go",
        "storage.type.string.go",
        "storage.type.uintptr.go",
        "storage.type.error.go",
        "storage.type.rune.go",
        "storage.type.cs",
        "storage.type.generic.cs",
        "storage.type.modifier.cs",
        "storage.type.variable.cs",
        "storage.type.annotation.java",
        "storage.type.generic.java",
        "storage.type.java",
        "storage.type.object.array.java",
        "storage.type.primitive.array.java",
        "storage.type.primitive.java",
        "storage.type.token.java",
        "storage.type.groovy",
        "storage.type.annotation.groovy",
        "storage.type.parameters.groovy",
        "storage.type.generic.groovy",
        "storage.type.object.array.groovy",
        "storage.type.primitive.array.groovy",
        "storage.type.primitive.groovy"
      ],
      "settings": {
        "foreground": "#00dfc0"
      }
    },
    {
      "name": "variable",
      "scope": [
        "variable",
        "meta.definition.variable.name",
        "support.variable",
        "entity.name.variable",
        "constant.other.placeholder",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#00daf2"
      }
    },
    {
      "name": "property",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "support.type.vendored.property-name",
        "variable.other.property",
        "meta.structure.dictionary.key.python"
      ],
      "settings": {
        "foreground": "#f4c000"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.css",
        "entity.name.tag.less",
        "punctuation.definition.tag",
        "keyword.operator.quantifier.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#d0bcff"
      }
    },
    {
      "name": "interpolation",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#d0bcff"
      }
    },
    {
      "name": "markupHeading",
      "scope": [
        "markup.heading",
        "header"
      ],
      "settings": {
        "foreground": "#b1c5ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markupBold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#b1c5ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markupItalic",
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "foreground": "#b1c5ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "markupInserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#40e26e"
      }
    },
    {
      "name": "markupDeleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ffb1c8"
      }
    },
    {
      "name": "markupChanged",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#00daf2"
      }
    },
    {
      "name": "markdownRaw",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#40e26e"
      }
    },
    {
      "name": "markdownQuote",
      "scope": [
        "punctuation.definition.quote.begin.markdown"
      ],
      "settings": {
        "foreground": "#ababab"
      }
    },
    {
      "name": "link",
      "scope": [
        "markup.underline.link.markdown"
      ],
      "settings": {
        "foreground": "#88ceff",
        "fontStyle": "underline"
      }
    },
    {
      "name": "diffHeader",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#00daf2"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ffb1c8"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "newOperator": "#88ceff",
    "stringLiteral": "#40e26e",
    "customLiteral": "#b7d300",
    "numberLiteral": "#ffb4a5"
  }
}

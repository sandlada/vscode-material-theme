{
  "$schema": "vscode://schemas/color-theme",
  "name": "MD3:Neutral 180 Light",
  "colors": {
    "focusBorder": "#57605d",
    "foreground": "#303332",
    "disabledForeground": "#797b7a",
    "descriptionForeground": "#5d5f5e",
    "errorForeground": "#9f403d",
    "icon.foreground": "#303332",
    "widget.border": "#b1b2b0",
    "widget.shadow": "#000000",
    "selection.background": "#e2e3e1",
    "sash.hoverBorder": "#57605d",
    "button.background": "#57605d",
    "button.foreground": "#f0faf5",
    "button.border": "#b1b2b0",
    "button.separator": "#b1b2b0",
    "button.hoverBackground": "#57605d",
    "button.secondaryBackground": "#e2e3e1",
    "button.secondaryForeground": "#303332",
    "button.secondaryHoverBackground": "#e2e3e1",
    "checkbox.background": "#e2e3e1",
    "checkbox.border": "#797b7a",
    "dropdown.background": "#e2e3e1",
    "dropdown.border": "#b1b2b0",
    "dropdown.foreground": "#303332",
    "dropdown.listBackground": "#e8e8e6",
    "input.background": "#e2e3e1",
    "input.border": "#b1b2b0",
    "input.foreground": "#303332",
    "input.placeholderForeground": "#5d5f5e",
    "scrollbarSlider.background": "#e2e3e1",
    "scrollbarSlider.hoverBackground": "#b1b2b0",
    "scrollbarSlider.activeBackground": "#797b7a",
    "badge.background": "#57605d",
    "badge.foreground": "#f0faf5",
    "progressBar.background": "#57605d",
    "list.activeSelectionBackground": "#e2e3e1",
    "list.activeSelectionForeground": "#303332",
    "list.inactiveSelectionBackground": "#e8e8e6",
    "list.inactiveSelectionForeground": "#303332",
    "list.hoverBackground": "#e8e8e6",
    "list.hoverForeground": "#303332",
    "list.focusOutline": "#57605d",
    "list.highlightForeground": "#57605d",
    "list.errorForeground": "#9f403d",
    "list.warningForeground": "#752121",
    "activityBar.background": "#eeeeec",
    "activityBar.foreground": "#303332",
    "activityBar.inactiveForeground": "#5d5f5e",
    "activityBar.border": "#b1b2b0",
    "activityBar.activeBorder": "#57605d",
    "activityBarBadge.background": "#57605d",
    "activityBarBadge.foreground": "#f0faf5",
    "sideBar.background": "#eeeeec",
    "sideBar.foreground": "#303332",
    "sideBar.border": "#b1b2b0",
    "sideBarTitle.foreground": "#303332",
    "sideBarSectionHeader.background": "#eeeeec",
    "sideBarSectionHeader.foreground": "#5d5f5e",
    "sideBarSectionHeader.border": "#b1b2b0",
    "editorGroup.border": "#b1b2b0",
    "editorGroup.dropBackground": "#57605d66",
    "editorGroupHeader.tabsBackground": "#eeeeec",
    "editorGroupHeader.tabsBorder": "#b1b2b0",
    "tab.activeBackground": "#fbf9f7",
    "tab.activeForeground": "#303332",
    "tab.activeBorderTop": "#57605d",
    "tab.inactiveBackground": "#e8e8e6",
    "tab.inactiveForeground": "#5d5f5e",
    "tab.hoverBackground": "#e2e3e1",
    "tab.border": "#b1b2b0",
    "tab.unfocusedActiveBackground": "#eeeeec",
    "editor.background": "#fbf9f7",
    "editor.foreground": "#303332",
    "editorLineNumber.foreground": "#797b7a",
    "editorLineNumber.activeForeground": "#303332",
    "editorCursor.foreground": "#57605d",
    "editor.selectionBackground": "#e2e3e1",
    "editor.inactiveSelectionBackground": "#e8e8e6",
    "editor.lineHighlightBackground": "#eeeeec",
    "editorWhitespace.foreground": "#b1b2b0",
    "editorIndentGuide.background": "#b1b2b0",
    "editorIndentGuide.activeBackground": "#797b7a",
    "editorBracketMatch.background": "#e0e3e166",
    "editorBracketMatch.border": "#797b7a",
    "editor.findMatchBackground": "#57605d66",
    "editor.findMatchHighlightBackground": "#e0e3e166",
    "editor.hoverHighlightBackground": "#e0e3e166",
    "editor.rangeHighlightBackground": "#e0e3e166",
    "editorError.foreground": "#9f403d",
    "editorWarning.foreground": "#752121",
    "editorInfo.foreground": "#5c605e",
    "editorGutter.addedBackground": "#516449",
    "editorGutter.modifiedBackground": "#5c605e",
    "editorGutter.deletedBackground": "#9f403d",
    "diffEditor.insertedTextBackground": "#e8e8e666",
    "diffEditor.removedTextBackground": "#e8e8e666",
    "diffEditor.insertedLineBackground": "#e8e8e666",
    "diffEditor.removedLineBackground": "#e8e8e666",
    "gitDecoration.addedResourceForeground": "#516449",
    "gitDecoration.modifiedResourceForeground": "#5c605e",
    "gitDecoration.deletedResourceForeground": "#9f403d",
    "gitDecoration.untrackedResourceForeground": "#516449",
    "terminal.background": "#eeeeec",
    "terminal.foreground": "#303332",
    "terminalCursor.foreground": "#57605d",
    "terminal.selectionBackground": "#e2e3e1",
    "statusBar.background": "#eeeeec",
    "statusBar.foreground": "#303332",
    "statusBar.border": "#b1b2b0",
    "statusBarItem.hoverBackground": "#e8e8e6",
    "statusBar.debuggingBackground": "#9f403d",
    "statusBar.debuggingForeground": "#fff7f6",
    "statusBar.noFolderBackground": "#eeeeec",
    "titleBar.activeBackground": "#eeeeec",
    "titleBar.activeForeground": "#303332",
    "titleBar.inactiveBackground": "#f5f3f2",
    "titleBar.inactiveForeground": "#5d5f5e",
    "titleBar.border": "#b1b2b0",
    "panel.background": "#eeeeec",
    "panel.border": "#b1b2b0",
    "panelTitle.activeBorder": "#57605d",
    "panelTitle.activeForeground": "#303332",
    "panelTitle.inactiveForeground": "#5d5f5e",
    "quickInput.background": "#e8e8e6",
    "quickInput.foreground": "#303332",
    "notifications.background": "#e8e8e6",
    "notifications.border": "#b1b2b0",
    "notifications.foreground": "#303332",
    "textLink.foreground": "#57605d",
    "textLink.activeForeground": "#57605d",
    "textBlockQuote.background": "#e8e8e6",
    "textBlockQuote.border": "#b1b2b0",
    "textCodeBlock.background": "#ffffff",
    "menu.background": "#fbf9f7",
    "menu.foreground": "#303332",
    "menu.selectionBackground": "#e2e3e1",
    "menu.selectionForeground": "#303332",
    "menu.separatorBackground": "#b1b2b0",
    "menu.border": "#b1b2b0"
  },
  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#777777"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "string.tag",
        "string.value",
        "meta.embedded.assembly",
        "meta.preprocessor.string"
      ],
      "settings": {
        "foreground": "#006e2c"
      }
    },
    {
      "name": "value",
      "scope": [
        "support.constant.property-value",
        "support.constant.font-name",
        "support.constant.media-type",
        "support.constant.media",
        "constant.other.color.rgb-value",
        "constant.other.rgb-value",
        "support.constant.color",
        "punctuation.definition.group.regexp",
        "punctuation.definition.group.assertion.regexp",
        "punctuation.definition.character-class.regexp",
        "punctuation.character.set.begin.regexp",
        "punctuation.character.set.end.regexp",
        "keyword.operator.negation.regexp",
        "support.other.parenthesis.regexp"
      ],
      "settings": {
        "foreground": "#006e2c"
      }
    },
    {
      "name": "stringRegexp",
      "scope": [
        "string.regexp",
        "constant.regexp",
        "constant.character.character-class.regexp",
        "constant.other.character-class.set.regexp",
        "constant.other.character-class.regexp",
        "constant.character.set.regexp"
      ],
      "settings": {
        "foreground": "#9d23aa"
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric",
        "keyword.operator.plus.exponent",
        "keyword.operator.minus.exponent",
        "meta.preprocessor.numeric"
      ],
      "settings": {
        "foreground": "#b22b13"
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant.language",
        "variable.other.constant",
        "variable.other.enummember",
        "constant.character",
        "constant.other.option"
      ],
      "settings": {
        "foreground": "#8f4e00"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "keyword.operator.wordlike",
        "keyword.other.unit",
        "storage",
        "storage.modifier",
        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#0056d0"
      }
    },
    {
      "name": "keywordControl",
      "scope": [
        "keyword.control",
        "source.cpp keyword.operator.new",
        "keyword.operator.delete",
        "keyword.other.using",
        "keyword.other.directive.using",
        "keyword.other.operator",
        "entity.name.operator"
      ],
      "settings": {
        "foreground": "#006590"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#5e5e5e"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "support.constant.handlebars",
        "source.powershell variable.other.member",
        "entity.name.operator.custom-literal",
        "keyword.operator.or.regexp",
        "keyword.control.anchor.regexp"
      ],
      "settings": {
        "foreground": "#566500"
      }
    },
    {
      "name": "type",
      "scope": [
        "support.class",
        "support.type",
        "entity.name.type",
        "entity.name.namespace",
        "entity.other.attribute",
        "entity.name.scope-resolution",
        "entity.name.class",
        "storage.type",
        "meta.type.cast.expr",
        "meta.type.new.expr",
        "support.constant.math",
        "support.constant.dom",
        "support.constant.json",
        "entity.other.inherited-class",
        "punctuation.separator.namespace.ruby",
        "storage.type.numeric.go",
        "storage.type.byte.go",
        "storage.type.boolean.go",
        "storage.type.string.go",
        "storage.type.uintptr.go",
        "storage.type.error.go",
        "storage.type.rune.go",
        "storage.type.cs",
        "storage.type.generic.cs",
        "storage.type.modifier.cs",
        "storage.type.variable.cs",
        "storage.type.annotation.java",
        "storage.type.generic.java",
        "storage.type.java",
        "storage.type.object.array.java",
        "storage.type.primitive.array.java",
        "storage.type.primitive.java",
        "storage.type.token.java",
        "storage.type.groovy",
        "storage.type.annotation.groovy",
        "storage.type.parameters.groovy",
        "storage.type.generic.groovy",
        "storage.type.object.array.groovy",
        "storage.type.primitive.array.groovy",
        "storage.type.primitive.groovy"
      ],
      "settings": {
        "foreground": "#006b5b"
      }
    },
    {
      "name": "variable",
      "scope": [
        "variable",
        "meta.definition.variable.name",
        "support.variable",
        "entity.name.variable",
        "constant.other.placeholder",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#006874"
      }
    },
    {
      "name": "property",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "support.type.vendored.property-name",
        "variable.other.property",
        "meta.structure.dictionary.key.python"
      ],
      "settings": {
        "foreground": "#755b00"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.css",
        "entity.name.tag.less",
        "punctuation.definition.tag",
        "keyword.operator.quantifier.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#6e37dd"
      }
    },
    {
      "name": "interpolation",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#6e37dd"
      }
    },
    {
      "name": "markupHeading",
      "scope": [
        "markup.heading",
        "header"
      ],
      "settings": {
        "foreground": "#0056d0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markupBold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#0056d0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markupItalic",
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "foreground": "#0056d0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "markupInserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#006e2c"
      }
    },
    {
      "name": "markupDeleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#b21e62"
      }
    },
    {
      "name": "markupChanged",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#006874"
      }
    },
    {
      "name": "markdownRaw",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#006e2c"
      }
    },
    {
      "name": "markdownQuote",
      "scope": [
        "punctuation.definition.quote.begin.markdown"
      ],
      "settings": {
        "foreground": "#777777"
      }
    },
    {
      "name": "link",
      "scope": [
        "markup.underline.link.markdown"
      ],
      "settings": {
        "foreground": "#006590",
        "fontStyle": "underline"
      }
    },
    {
      "name": "diffHeader",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#006874"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#b21e62"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "newOperator": "#006590",
    "stringLiteral": "#006e2c",
    "customLiteral": "#566500",
    "numberLiteral": "#b22b13"
  }
}

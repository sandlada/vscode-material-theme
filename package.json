{
  "name": "vscode-material-design-theme",
  "displayName": "Material Design 3 Theme",
  "version": "0.0.2",
  "publisher": "sandlada",
  "description": "Material Design 3 (Material You) color themes for VSCode. Ported from @sandlada/opencode-material-theme (OpenCode TUI). 291 static themes: 9 variants x 12 HCT hues (Monochrome hue 0 only) x light/dark/dark-oled.",
  "repository": {
    "type": "git",
    "url": "https://github.com/sandlada/vscode-material-theme.git"
  },
  "homepage": "https://github.com/sandlada/vscode-material-theme#readme",
  "bugs": {
    "url": "https://github.com/sandlada/vscode-material-theme/issues"
  },
  "scripts": {
    "generate:vscode": "bun scripts/generate-vscode-theme.mjs",
    "matrix:vscode": "bun scripts/generate-vscode-matrix.mjs --out ./themes",
    "probe:semantic": "bun scripts/probe-semantic-palettes.mjs",
    "probe:syntax": "bun scripts/probe-syntax-palettes.mjs",
    "probe": "bun scripts/probe-semantic-palettes.mjs && bun scripts/probe-syntax-palettes.mjs",
    "package": "vsce package"
  },
  "keywords": [
    "vscode",
    "theme",
    "themes",
    "color-theme",
    "material-design-3",
    "material-you",
    "md3",
    "material-color-utilities",
    "oled"
  ],
  "author": "Kai Orion & Sandlada",
  "license": "MIT",
  "type": "module",
  "categories": [
    "Themes"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },

{
  "name": "@sandlada/vscode-material-theme",
  "displayName": "MD3 Material Theme",
  "version": "0.0.1",
  "description": "Material Design 3 (Material You) color themes for VSCode. Ported from @sandlada/opencode-material-theme (OpenCode TUI). No themes generated yet.",
  "scripts": {
    "generate": "bun scripts/generate-md3-tokens.mjs",
    "matrix": "bun scripts/generate-md3-matrix.mjs --out ./tui",
    "generate:vscode": "bun scripts/generate-vscode-theme.mjs"
  },
  "keywords": [
    "vscode",
    "theme",
    "themes",
    "color-theme",
    "material-design-3",
    "material-you",
    "md3",
    "material-color-utilities",
    "oled"
  ],
  "author": "Kai Orion & Sandlada",
  "license": "MIT",
  "type": "module",
  "categories": [
    "Themes"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "contributes": {
    "themes": [
      {
        "label": "MD3 Expressive 150 Light",
        "uiTheme": "vs",
        "path": "./themes/md3-expressive-150-light-color-theme.json"
      },
      {
        "label": "MD3 Expressive 150 Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/md3-expressive-150-dark-color-theme.json"
      },
      {
        "label": "MD3 Expressive 150 Light OLED",
        "uiTheme": "vs",
        "path": "./themes/md3-expressive-150-light-oled-color-theme.json"
      },
      {
        "label": "MD3 Expressive 150 Dark OLED",
        "uiTheme": "vs-dark",
        "path": "./themes/md3-expressive-150-dark-oled-color-theme.json"
      },
      {
        "label": "MD3 Fidelity 150 Light",
        "uiTheme": "vs",
        "path": "./themes/md3-fidelity-150-light-color-theme.json"
      },
      {
        "label": "MD3 Fidelity 150 Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/md3-fidelity-150-dark-color-theme.json"
      },
      {
        "label": "MD3 TonalSpot 150 Light",
        "uiTheme": "vs",
        "path": "./themes/md3-tonal-spot-150-light-color-theme.json"
      },
      {
        "label": "MD3 TonalSpot 150 Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/md3-tonal-spot-150-dark-color-theme.json"
      }
    ]
  },
  "files": [
    "themes/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@sandlada/mcu-helper": "^0.1.0-20260830.a"
  }
}
